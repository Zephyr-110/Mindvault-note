# ============================================
# MindVault 环境变量模板
# 复制此文件为 .env 并填写真实值
# cp .env.example .env
# ============================================

# ── MySQL ──
MYSQL_ROOT_PASSWORD=请替换为强密码

# ── Redis ──
REDIS_PASSWORD=请替换为强密码

# ── JWT ──
JWT_SECRET=请替换为至少32位随机字符串

# ── 阿里云 OSS ──
OSS_ACCESS_KEY=你的阿里云AccessKey
OSS_ACCESS_SECRET=你的阿里云AccessSecret
OSS_BUCKET=mindvault-files

# ── 前端端口 ──
FRONTEND_PORT=80

# ── 阿里百炼 DashScope（AI 对话）──
LLM_API_KEY=你的DashScope API Key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus